# ─── Copy to .env and fill in ─────────────────────────────────────────────
# cp .env.example .env    (then edit)
# .env is gitignored. docker compose interpolates it into docker-compose.yml.

# Postgres password (generate one: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-postgres-password

# LLM providers
# DeepSeek — primary LLM + vision slot. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DeepInfra — failover LLM. https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=sk-di-your-deepinfra-key
# OpenRouter — reranker + decision model (Jev). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Hindsight bearer keys — one per user. ASCII, no commas.
# schema per user: user_hermes_agent / user_deepseek_harness
HERMES_API_KEY=hk_change-me-hermes-agent
DEEPSEEK_HARNESS_API_KEY=dk_change-me-deepseek-harness

# Control Plane UI access key (mint something long and random)
HINDSIGHT_CP_ACCESS_KEY=change-me-cp-access-key

# Webhook HMAC signing secret
WEBHOOK_SECRET=whsec_change-me

# ─── Optional overrides ───────────────────────────────────────────────────
# EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B   # local fallback: BAAI/bge-m3 + EMBEDDINGS_BASE_URL=http://bge-m3:8000/v1
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B   # any DeepInfra reranker id
# HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.1.0-slim
# HINDSIGHT_API_PORT=8888
# HINDSIGHT_CP_PORT=9999
# WEBHOOK_SINK_PORT=8087
