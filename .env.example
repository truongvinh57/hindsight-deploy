# ─── Copy to .env and fill in ─────────────────────────────────────────────
#   cp .env.example .env
# .env is gitignored; docker compose interpolates it into docker-compose.yml.
# Anything left as a template placeholder makes the smoke test refuse to run.

# ─── Required secrets ─────────────────────────────────────────────────────
# Postgres password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-postgres-password
# Postgres database/user. Change them if you like - every ops command in the
# README and both smoke-test scripts read these values from .env.
# POSTGRES_USER=hindsight
# POSTGRES_DB=hindsight

# LLM / model providers
# DeepSeek - primary LLM + vision slot: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DeepInfra - LLM failover, embeddings (Qwen3-Embedding) and reranker
# (Qwen3-Reranker, through rerank-adapter): https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=sk-di-your-deepinfra-key
# OpenRouter - serves Jev (the decision model) via its System One API:
# https://openrouter.ai/keys . Required: Jev does the jobs nothing else can
# (consolidation triage, knowledge-page impact, reflect evidence sufficiency).
# Recall ranking does NOT use it - that stays on the Qwen3-Reranker.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Hindsight bearer keys - one per user, ASCII, no commas.
# Each user gets its own Postgres schema:
#   hermes-agent -> user_hermes_agent   (also the control-plane's data-plane key)
#   cherry-studio    -> user_cherry_studio
HERMES_API_KEY=hk_change-me-hermes-agent
CHERRY_STUDIO_API_KEY=cs_change-me-cherry-studio

# Control Plane UI access key (this is effectively a hermes-agent credential)
HINDSIGHT_CP_ACCESS_KEY=change-me-cp-access-key

# Webhook HMAC signing secret
WEBHOOK_SECRET=whsec_change-me

# ─── Optional overrides ───────────────────────────────────────────────────
# Images (pin a newer release by changing these, then: docker compose pull)
# HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.1.0-slim
# HINDSIGHT_CP_IMAGE=ghcr.io/vectorize-io/hindsight-control-plane:1.1.0

# Networking. BIND_ADDR defaults to 127.0.0.1: the API speaks plain HTTP with
# bearer keys, so exposing it to the LAN is a decision you make deliberately
# (put TLS/reverse proxy in front, or set BIND_ADDR=0.0.0.0).
# BIND_ADDR=127.0.0.1
# HINDSIGHT_API_PORT=8888
# HINDSIGHT_CP_PORT=9999
# WEBHOOK_SINK_PORT=8087
# COMPOSE_PROJECT_NAME=hindsight   # change to run a second stack on one host

# Resource caps. Defaults target a 4 vCPU / 8 GB host (containers ~2.9 GB total).
# Raise them on a bigger machine; Docker's VM must be given the RAM to match.
# API_MEM_LIMIT=1g
# WORKER_MEM_LIMIT=768m
# DB_MEM_LIMIT=768m
# CP_MEM_LIMIT=192m
# SINK_MEM_LIMIT=64m
# ADAPTER_MEM_LIMIT=96m
# The control plane is a Next.js UI: 0.5 CPU throttles it in ~half of all periods
# and 192m is a hard ceiling it actually reaches. 1 CPU / 320m is the sane floor.
# CP_CPUS=1.0
# CP_MEM_LIMIT=320m
# SINK_CPUS=0.25
#
# "Tiny" set for a 4 GB host (Docker VM needs >= 3 GB; Docker Desktop defaults
# to ~50% of host RAM, so set memory in .wslconfig on Windows). Single user,
# light traffic, and consider dropping control-plane + webhook-sink entirely:
# API_MEM_LIMIT=768m
# WORKER_MEM_LIMIT=640m
# DB_MEM_LIMIT=512m
# CP_MEM_LIMIT=128m
# SINK_MEM_LIMIT=32m
# ADAPTER_MEM_LIMIT=64m
# WORKER_MAX_SLOTS=3
# LLM_MAX_CONCURRENT=2
# DECISION_MODEL_MAX_CONCURRENT=4
# EMBEDDINGS_MAX_CONCURRENT=2

# Throughput knobs (all remote calls, so these are I/O concurrency, not CPU)
# WORKER_MAX_SLOTS=5
# LLM_MAX_CONCURRENT=5
# DECISION_MODEL_MAX_CONCURRENT=8
# EMBEDDINGS_MAX_CONCURRENT=4
# DB_POOL_MAX_SIZE=12
# WORKER_DB_POOL_MAX_SIZE=8

# Models
# LLM_MODEL=deepseek-flash
# LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# LLM_TIMEOUT=180
# EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDINGS_BASE_URL=https://api.deepinfra.com/v1/openai
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# DECISION_MODEL_PROVIDER=typesafe       # Jev ON (needs OPENROUTER_API_KEY). To run without it
#                                       # set "none" AND relax the compose guard on that key.
# RECALL_DECISION_MODEL_PROVIDER=none    # "typesafe" = rank recall with Jev instead of the
#                                       # Qwen3-Reranker (better on superseded facts, ~2.8x cost,
#                                       # and OpenRouter becomes a hard dependency of reads)
# RERANK_ADAPTER_TIMEOUT=25
# RERANK_ADAPTER_CONCURRENCY=16

# Retention / logging
# AUDIT_LOG_RETENTION_DAYS=90
# LLM_TRACE_RETENTION_DAYS=7
# LLM_TRACE_MAX_CHARS=8000
# OPERATION_RETENTION_DAYS=30
# LOG_LEVEL=info
# HINDSIGHT_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# HTTP(S) proxy for outbound model calls. NO_PROXY always keeps the compose
# service names direct; note that image PULLS use the Docker daemon's own proxy
# settings, which compose cannot supply.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,db,api,worker,control-plane,webhook-sink,rerank-adapter
